---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import {
  LEGAL_ORDER,
  LEGAL_PAGES,
  LEGAL_UPDATED,
  type LegalPage,
} from "../data/legal";

export function getStaticPaths() {
  return LEGAL_ORDER.map((slug) => ({
    params: { slug },
    props: { page: LEGAL_PAGES[slug], slug },
  }));
}

interface Props {
  page: LegalPage;
  slug: string;
}
const { page, slug } = Astro.props as Props;

// Legal copy is plain text, so links are written as bare URLs. The capture group
// makes split() place each URL at an odd index; trailing punctuation stays text.
const URL_PATTERN = /(https:\/\/\S*[^\s.,;:)])/;

const path = `/${slug}`;
const description = page.summary;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      {
        "@type": "ListItem",
        position: 2,
        name: page.title,
        item: new URL(path, SITE.url).href,
      },
    ],
  },
];
---

<BaseLayout title={page.title} description={description} path={path} schema={schema}>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="text-xs font-semibold uppercase leading-5 tracking-widest text-sky-700 sm:text-sm">Legal</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{page.title}</h1>
    <p class="mt-3 text-sm text-slate-500">Last updated: {LEGAL_UPDATED}</p>
    <p class="mt-6 text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">{page.summary}</p>
    <div class="mt-10 space-y-9">
      {
        page.sections.map((section) => (
          <section>
            <h2 class="text-xl font-semibold tracking-tight text-slate-900">
              {section.heading}
            </h2>
            <div class="mt-3 space-y-3 leading-7 text-slate-600">
              {section.body.map((paragraph) => (
                <p>
                  {paragraph.split(URL_PATTERN).map((part, index) =>
                    index % 2 === 1 ? (
                      <a
                        href={part}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="break-words text-sky-700 underline hover:text-sky-800"
                      >
                        {part}
                      </a>
                    ) : (
                      part
                    ),
                  )}
                </p>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
