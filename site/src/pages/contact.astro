---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { LEGAL_CONTACT } from "../data/legal";

const path = "/contact";
const description =
  "Get in touch with the Plug & Play team about the product, billing, or privacy.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: `Contact ${SITE.name}`,
    url: new URL(path, SITE.url).href,
  },
];
---

<BaseLayout title="Contact" description={description} path={path} schema={schema}>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="text-xs font-semibold uppercase leading-5 tracking-widest text-sky-700 sm:text-sm">Contact</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">Get in touch</h1>
    <p class="mt-6 text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">
      Questions about the product, your plan and billing, or a privacy request? Email us
      and a real person will get back to you.
    </p>

    <div class="mt-10 min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
      <p class="text-sm font-medium uppercase tracking-wide text-slate-500">Email</p>
      <a
        href={`mailto:${LEGAL_CONTACT}`}
        class="mt-2 inline-block max-w-full break-all text-lg font-semibold text-sky-700 hover:text-sky-800 sm:text-2xl"
      >
        {LEGAL_CONTACT}
      </a>
      <p class="mt-4 text-sm leading-7 text-slate-600">
        Use the same address for privacy and data requests under the GDPR - see our
        <a href="/privacy-policy" class="text-sky-700 underline hover:text-sky-800"
          >Privacy Policy</a
        >. We aim to reply within two business days.
      </p>
    </div>
  </section>
</BaseLayout>
