---
import { SITE } from "../config";
import { LEGAL_ORDER, LEGAL_PAGES } from "../data/legal";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p class="flex flex-col items-start gap-2 sm:flex-row sm:items-center">
      <img src="/logo-horizontal-full-color.png" alt="" class="h-8 w-auto shrink-0 sm:h-9" />
      <span>&copy; {year} {SITE.name}. All rights reserved.</span>
    </p>
    <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-3">
      <a href="/contact" class="hover:text-slate-900">Contact</a>
      {
        LEGAL_ORDER.map((slug) => (
          <a href={`/${slug}`} class="hover:text-slate-900">
            {LEGAL_PAGES[slug].title}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
